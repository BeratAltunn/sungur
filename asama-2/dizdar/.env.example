# Kopyalayın:  cp .env.example .env   (.env git'e ve Docker imajına girmez; anahtarı kimseyle paylaşmayın)

# --- Şu an kullanılan: hackathon GLM ağ geçidi (LiteLLM, OpenAI uyumlu, Authorization: Bearer) ---
# Anahtar takıma özeldir (gorev_tanimi.pdf). Bütçe takım başına 15 USD, SIFIRLANMAZ; 60 istek/dk, aynı anda en fazla 4 istek.
# Kalan bütçe:  curl -s "${GLM_BASE_URL%/v1}/key/info" -H "Authorization: Bearer $GLM_API_KEY"   (spend / max_budget)
GLM_BASE_URL=https://berriailitellm-databasev1826rc3-production-d691.up.railway.app/v1
GLM_API_KEY=
GLM_MODEL=glm-5.3-flash
GLM_TIMEOUT_S=120
# Fiyat bilinmediği için GLM_PRICE_IN/OUT verilmez: bütçe bekçisi config.yaml'daki temkinli varsayılanlarla sayar.

# --- Yedek: Evren LLM platformu (ücretsiz, kişisel anahtar, kimlik X-API-Key başlığıyla) ---
# Geçmek için yukarıdaki blok yerine bunları açın. Her ekip üyesi kendi anahtarını Evren /api-keys sayfasından üretir.
# GLM_BASE_URL=https://evren-llmapi.ssyz.org.tr/v1
# GLM_API_KEY=
# GLM_MODEL=glm-5.3
# GLM_AUTH_HEADER=X-API-Key
# GLM_PRICE_IN=0
# GLM_PRICE_OUT=0

# --- İsteğe bağlı ---
# GLM_REASONING_EFFORT=low        # config.yaml'daki varsayılanı geçersiz kılar; boş = gönderme
# SENTINEL_DETECTOR=oracle        # model olmadan test (sınıf bilinmez)
# SENTINEL_LLM=mock               # LLM olmadan deterministik sahte cevaplar (test)
# SENTINEL_DATA_DIR=/baska/bir/yol/data   # veri paketi ../data dışındaysa
# SENTINEL_CONFIG=config.yaml
