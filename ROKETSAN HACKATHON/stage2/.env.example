# Kopyalayın:  cp .env.example .env   (.env git'e girmez; anahtarınızı kimseyle paylaşmayın)

# --- Şu an kullanılan: Evren LLM platformu (OpenAI uyumlu, kimlik X-API-Key başlığıyla) ---
# Her ekip üyesi kendi anahtarını Evren portalındaki /api-keys sayfasından üretir.
GLM_BASE_URL=https://evren-llmapi.ssyz.org.tr/v1
GLM_API_KEY=
GLM_MODEL=glm-5.3
GLM_AUTH_HEADER=X-API-Key
GLM_PRICE_IN=0
GLM_PRICE_OUT=0
GLM_TIMEOUT_S=120

# --- Hackathon GLM anahtarı gelince yukarıdaki bloğun yerine (GLM_AUTH_HEADER satırını silin) ---
# GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
# GLM_API_KEY=
# GLM_MODEL=glm-4.5

# --- İsteğe bağlı ---
# GLM_REASONING_EFFORT=low        # config.yaml'daki varsayılanı geçersiz kılar; boş = gönderme
# SENTINEL_DETECTOR=oracle        # model olmadan test (sınıf bilinmez)
# SENTINEL_LLM=mock               # LLM olmadan deterministik sahte cevaplar (test)
# SENTINEL_DATA_DIR=/yol/resmi_paket
# SENTINEL_CONFIG=config.yaml
