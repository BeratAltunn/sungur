# GLM (OpenAI uyumlu uç nokta). Anahtarlar 2. aşamada dağıtılacak.
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
GLM_API_KEY=
GLM_MODEL=glm-4.5

# GLM gelene kadar Evren platformu (OpenAI uyumlu, X-API-Key başlığı):
# GLM_BASE_URL=https://evren-llmapi.ssyz.org.tr/v1
# GLM_API_KEY=evren_llm_...
# GLM_MODEL=glm-5.3
# GLM_AUTH_HEADER=X-API-Key
# GLM_PRICE_IN=0
# GLM_PRICE_OUT=0

# ya da lokal model (Ollama, OpenAI uyumlu):
# GLM_BASE_URL=http://localhost:11434/v1
# GLM_API_KEY=ollama
# GLM_MODEL=glm4:9b
# GLM_PRICE_IN=0
# GLM_PRICE_OUT=0
# GLM_TIMEOUT_S=180

# İsteğe bağlı geçersiz kılmalar
